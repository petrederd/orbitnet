# MaxMind GeoLite2 credentials.
#
# Only needed for the optional geoip-updater service that keeps the
# databases in data/geoip/ fresh (MaxMind requires updates < 30 days).
#
# 1. Create a free GeoLite2 account:
#    https://www.maxmind.com/en/geolite2/signup
# 2. Generate a license key under Account > Manage License Keys.
# 3. Copy this file to .env and fill in the values below.
# 4. Start the updater:
#    docker compose --profile geoip up -d
#
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# External checker (Cloudflare Worker): HTTP, DNS, propagation, email.
#
# Used only as a fallback when local HTTP, DNS, propagation, email or redirect
# checks fail because of blocking or filtering (for example, inside Russia).
# Leave both empty to disable the fallback.
#
# Deploy the worker from worker/ (see worker/README.md), then copy the URL and
# the secret you set with `wrangler secret put CHECKER_SECRET` here.
# Never commit this file with real values: .env is gitignored.
CHECKER_URL=
CHECKER_SECRET=
# Optional, milliseconds (default 20000).
CHECKER_TIMEOUT=20000
