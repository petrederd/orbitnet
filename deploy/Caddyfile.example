# Example Caddy configuration for the OrbitNet origin.
#
# Goal: make Caddy accept the real client IP from Cloudflare's CF-Connecting-IP
# header ONLY when the connection actually comes from a Cloudflare edge. If a
# client connects to the origin directly (bypassing Cloudflare), Caddy ignores
# the spoofed header and uses the peer address instead.
#
# Two layers of defence are recommended:
#   1. Firewall the origin so only Cloudflare edge IPs may connect (or use
#      Cloudflare Authenticated Origin Pulls). See https://www.cloudflare.com/ips/
#   2. Set trusted_proxies + client_ip_headers below.
#
# The Cloudflare ranges come from cloudflare-trusted-proxies.caddy, which is
# generated by scripts/update-cloudflare-ips.sh together with cloudflare-ips.conf
# and installed next to this Caddyfile at deploy time.
#
# Privacy: request logs are off unless you explicitly enable the sanitised
# 7-day access log. Runtime/error logs are filtered below so they keep the
# diagnostic message but never the client IP, headers or request URI. Follow
# the example in README.md ("Logs and privacy"). Never record client IPs,
# headers, or query strings.
{
	# Drop default access logs for requests that do not use the sanitised
	# site-specific logger below (for example scanners hitting the origin by IP).
	log {
		exclude http.log.access

		# Error and TLS logs would otherwise record the client IP and the full
		# request URI (including the query string) on failures. Keep the error
		# text and status, delete the identifying fields.
		format filter {
			wrap json
			fields {
				remote_ip delete
				remote_port delete
				client_ip delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>uri delete
				resp_headers delete
			}
		}
	}

	servers {
		# Generated from the same Cloudflare feed as cloudflare-ips.conf.
		# The deploy script installs it next to this Caddyfile; do not import
		# the repository path directly because the Caddy user may not be able
		# to traverse /home/<deploy-user>.
		import cloudflare-trusted-proxies.caddy
		# Parse only the header Cloudflare sets, and parse it right-to-left so a
		# client cannot prepend a fake value.
		client_ip_headers CF-Connecting-IP
		trusted_proxies_strict
	}
}

orbitnet.ru {
	# Caddy terminates TLS and forwards to nginx. With the provided
	# docker-compose.yml, nginx is published on the host at 127.0.0.1:8081
	# (there is no "nginx" DNS name unless Caddy runs in the compose network).
	reverse_proxy 127.0.0.1:8081 {
		# Always overwrite CF-Connecting-IP before forwarding to nginx. With
		# trusted_proxies_strict above, {client_ip} is the Cloudflare-resolved
		# visitor address when the peer is a Cloudflare edge, and the direct peer
		# address for every other connection. A client-supplied header therefore
		# never reaches nginx.
		header_up CF-Connecting-IP {client_ip}
	}

	# Let Caddy drive the forwarded-for headers itself (do not trust the
	# client's X-Forwarded-For).
	# (reverse_proxy already replaces X-Forwarded-For for trusted peers.)
}

# NOTE ON nginx: Caddy overwrites CF-Connecting-IP with {client_ip}, so nginx
# can keep using real_ip_header CF-Connecting-IP. It only needs to trust the
# local Caddy (and the Cloudflare ranges, if nginx is ever exposed directly):
#
#   set_real_ip_from 127.0.0.1;
#   set_real_ip_from 10.0.0.0/8;
#   set_real_ip_from 172.16.0.0/12;
#   set_real_ip_from 192.168.0.0/16;
#   real_ip_header CF-Connecting-IP;
#
# Do not rely on a client-supplied CF-Connecting-IP: the header_up line above
# is what makes the direct-to-origin case safe.
